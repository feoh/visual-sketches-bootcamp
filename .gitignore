# Harness logs and downloaded framework archives
.harness/
.openframeworks/
openframeworks/

# Project Generator metadata (generated inside canonical projects)
foundation/*/Makefile
foundation/*/config.make
foundation/*/.vscode/
foundation/*/*.code-workspace
foundation/*/*.xcodeproj/
foundation/*/Project.xcconfig
foundation/*/of.entitlements
foundation/*/openFrameworks-Info.plist
foundation/*/*.sln
foundation/*/*.vcxproj
foundation/*/*.vcxproj.filters
foundation/*/*.vcxproj.user
foundation/*/icon.rc

# Native build products; preserve foundation/*/bin/data/**
foundation/*/obj/
foundation/*/bin/*
!foundation/*/bin/data/
!foundation/*/bin/data/**
foundation/*/*.app/
foundation/*/*.exe
foundation/*/*.dll
foundation/*/*.pdb
foundation/*/*.ilk

# Section exercise Project Generator metadata and native products
exercises/*/*/Makefile
exercises/*/*/config.make
exercises/*/*/.vscode/
exercises/*/*/*.code-workspace
exercises/*/*/*.xcodeproj/
exercises/*/*/Project.xcconfig
exercises/*/*/of.entitlements
exercises/*/*/openFrameworks-Info.plist
exercises/*/*/*.sln
exercises/*/*/*.vcxproj
exercises/*/*/*.vcxproj.filters
exercises/*/*/*.vcxproj.user
exercises/*/*/icon.rc
exercises/*/*/obj/
exercises/*/*/bin/*
!exercises/*/*/bin/data/
!exercises/*/*/bin/data/**
exercises/*/*/*.app/
exercises/*/*/*.exe
exercises/*/*/*.dll
exercises/*/*/*.pdb
exercises/*/*/*.ilk
# Optional local Hugo publication output
.hugo-public/
.hugo_build.lock
resources/_gen/

# Optional personal course notes; keeping them outside the checkout is safer.
# .gitignore does not make files private or secure.
.pilot-private/

.DS_Store
